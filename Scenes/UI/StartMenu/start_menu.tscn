[node name="RichTextLabelTask" type="RichTextLabel" parent="Control/VBoxContainer/MarginContainerCommon/HBoxContainer/MarginContainerPanel/Panel/VBoxContainer/MarginContainerPanelPic/MarginContainerTask/HBoxContainer"]
layout_mode = 2
theme_override_colors/default_color = Color(0.168627, 0.0823529, 0.0862745, 1)
theme_override_fonts/normal_font = ExtResource("1_hs3dm")
theme_override_fonts/bold_font = ExtResource("3_7l1tg")
theme_override_font_sizes/normal_font_size = 23
theme_override_font_sizes/bold_font_size = 28
theme_override_font_sizes/italics_font_size = 23
theme_override_font_sizes/bold_italics_font_size = 23
theme_override_font_sizes/mono_font_size = 23
bbcode_enabled = true
text = "Успешно провести испытания насоса системы «чистого» конденсата.

[b]Цель проекта - проиграть ситуацию, получить\\освежить знания, познакомиться с опытом ПНР в системе через генератор случайных событий. [/b]

[b]На данный момент реализованы следующие сценарии из опыта ПНР: [/b]
1. Затопление текущего помещения - Фланец на всасе насоса №2 не уплотнен
2. Затопление смежного помещения - Не закрыта одна из трех арматур во всасывающий коллектор от других систем
3. Повышенный шум, вибрация, насос не развивает давление - Недостаточное заполнения корпуса насоса средой
4. НА работает больше 1 минуты с расходом 0,0 - Требуется ревизия
"
fit_content = true
scroll_active = false
autowrap_mode = 2
shortcut_keys_enabled = false

