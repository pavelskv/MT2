; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="MT-2"
config/version="1.0"
config/tags=PackedStringArray("wip")
run/main_scene="res://Scenes/Levels/mt2_level1.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(1, 1, 1, 1)
boot_splash/image="res://Assets/UI/logo.png"
config/icon="res://icon.png"

[audio]

buses/default_bus_layout="uid://ccy33576fiahm"

[autoload]

GameController="*res://Scenes/Autoloads/game_controller.gd"
MessageController="*res://Scenes/Autoloads/message_controller.gd"
WinScreen="*res://Scenes/Autoloads/WinScreen/win_screen.tscn"
LossScreen="*res://Scenes/Autoloads/LossScreen/loss_screen.tscn"
RetryScreen="*res://Scenes/Autoloads/RetryScreen/retry_screen.tscn"
RBCM_GameClient="*uid://ds38o1ejul3fx"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[editor]

version_control/plugin_name="GitPlugin"
version_control/autoload_on_startup=true

[editor_plugins]

enabled=PackedStringArray("res://addons/rb_condition_manager/plugin.cfg", "res://addons/rb_voice_generator/plugin.cfg")

[file_customization]

folder_colors={
"res://Assets/": "green",
"res://Scenes/": "yellow"
}

