{"code":{"condition":"%Phone.clicked","on_active":"","on_completed":"%Phone.enabled = false\n\n%RoomController.stop_one_minute_timer()\n%RoomController.stop_30min_timer()\n\nMessageController.show_message(\"ОРО Петров\", \"ОРО Петров. Металлический скрежет в районе подшипника №3.\")\n\nMessageController.show_message(\"ВИУР Иванов\", \"ВИУР Иванов. Насосный агрегат отключаю, вызываю ремонтный персонал.\")\n\nawait %RoomController.cutscene_ended\n\nawait %RoomController.wait(2)\n%Pump1.set_defaults()\n%Pump1.full_power = false\n%Pump1/RepairLogo.visible = true\n%Pump1/PodhipnikRattle.stop()\n\n%Pump1Sensor2.set_pressure_017()\n\nawait %RoomController.wait(2)\nMessageController.show_message(\"\", \"В результате разбора происшедшего выяснилось, что по причине отсутствия контроля за температурой подшипника инженером НО и ВИУР расплавился подшипник №3. Насос выведен в ремонт.\")\n\nMessageController.show_message(\"\", \"Инженер наладочной организации и ВИУР от работы отстранены с пересдачей экзамена по ОПЭ АС. Начните испытания заново.\")\n\nawait %RoomController.cutscene_ended\nLossScreen.show()"},"description":"Доложить на БПУ 9_2","id":"fAMd","out_connection_ids":[],"parent_ids":["gQOk"],"pos":"(26700, -1000)","priority":1,"type":1}
{"code":{"condition":"%Phone.clicked","on_active":"","on_completed":"%Phone.enabled = false\n\nMessageController.show_message(\"ВИУР Иванов\", \"ВИУР Иванов. Насосный агрегат отключился защитой по температуре подшипника. Насосный агрегат вывожу в ремонт.\")\n\nawait %RoomController.cutscene_ended\nawait %RoomController.wait(2)\n\nMessageController.show_message(\"\", \"За недостаточный контроль за работой насосного агрегата инженер наладочной организации и ВИУР отстранены от работы с пересдачей экзамена по ОПЭ АС.\")\n\nawait %RoomController.cutscene_ended\nLossScreen.show()"},"description":"Отчитать и начать сначала","id":"gqw8","out_connection_ids":[],"parent_ids":["d7ZL"],"pos":"(27320, -1620)","priority":"","type":1}
