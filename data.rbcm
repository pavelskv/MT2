{"code":{"condition":"%Phone.clicked","on_active":"","on_completed":"%Phone.enabled = false\n\n%PumpFlowController/Slider.value = 0\n%PumpFlowController/Slider.slide_to(0)\n\n%PumpFlowController.slider_wheel_enabled = false\n%PumpFlowController.slider_wheel_down_enabled = false\n%PumpFlowController.slider_wheel_up_enabled = true\n\nMessageController.show_message(\"ОРО Петров\", \"ОРО Петров. Задвижка на линии рециркуляции не управляется, оборван рабочий орган, требуется ревизия.\")\n\nMessageController.show_message(\"ВИУР Иванов\", \"ВИУР Иванов.Испытания прекращаем, вызываю ремонтный персонал.\")\n\nawait %RoomController.cutscene_ended\nawait %RoomController.wait(2)\n\nMessageController.show_message(\"\", \"Задвижка на линии рециркуляции выведена в ремонт. Выяснилась причина – снижение протока среды в напорной линии – оборван рабочий орган задвижки.\")\n\nawait %RoomController.cutscene_ended\nawait %RoomController.wait(1)\n\nRetryScreen.show()\n\n\n#MessageController.show_message(\"\", \"Ремонт задвижки произведен.\")\n\n#await %RoomController.cutscene_ended\n\n#%LoopLineVent/RepairLogo.visible = false\n#%LoopLineVent.enabled = true\n#%LoopLineVent.locked = false\n#%LoopLineVent.broken = false"},"description":"Доложить на БПУ 8_2 (backup)","id":"Gd4q","out_connection_ids":["oNC0"],"parent_ids":[],"pos":"(24080, -740)","priority":"","type":1}
