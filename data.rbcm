{"code":{"condition":"%Phone.clicked","on_active":"","on_completed":"%Phone.enabled = false\n\n%RoomController.stop_30min_timer()\n%RoomController.stop_one_minute_timer()\n\nMessageController.show_message(\"ОРО Петров\", \"ОРО Петров. Большая течь по уплотнению вала.\")\n\nMessageController.show_message(\"ВИУР Иванов\", \"ВИУР Иванов. Насосный агрегат отключаю, вызываю ремонтный персонал.\")\n\nawait %RoomController.cutscene_ended\n\nawait %RoomController.wait(3)\n%Pump1.full_power = false\n%Pump1.set_defaults()\n%Pump1/RepairLogo.visible = true\n\n%Pump1.leak_medium()\n\n%Pump1Sensor2.set_pressure_017()\n\nawait %RoomController.wait(5)\nMessageController.show_message(\"\", \"В результате разбора происшествия выяснилось, что насосный агрегат не был остановлен в начальной стадии развития течи по уплотнению вала, что привело к его разрушению потоком среды.\")\n\nMessageController.show_message(\"\", \"Насос выведен в ремонт. Инженер наладочной организации от работы отстранен с пересдачей экзамена по ОПЭ АС. Вам придется возобновить испытания.\")\n\nawait %RoomController.cutscene_ended\nLossScreen.show()"},"description":"Доложить на БПУ 10_2","id":"oJqk","out_connection_ids":[],"parent_ids":["BzDf"],"pos":"(32020, -700)","priority":1,"type":1}
